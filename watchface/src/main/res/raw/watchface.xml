<?xml version="1.0" encoding="utf-8"?>
<WatchFace height="450" width="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <Scene>
        <Condition>
            <Expressions>
                <Expression name="after_six">[HOUR_0_23] &gt;= 6</Expression>
            </Expressions>
            <Compare expression="after_six">
                <Condition>
                    <Expressions>
                        <Expression name="before_eighteen">[HOUR_0_23] &lt; 18</Expression>
                    </Expressions>
                    <Compare expression="before_eighteen">
                        <PartImage height="450" width="450" x="0" y="0">
                            <Image resource="persona_day" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage height="450" width="450" x="0" y="0">
                            <Image resource="persona_night" />
                        </PartImage>
                    </Default>
                </Condition>
            </Compare>
            <Default>
                <PartImage height="450" width="450" x="0" y="0">
                    <Image resource="persona_night" />
                </PartImage>
            </Default>
        </Condition>

        <PartDraw height="62" width="310" x="70" y="22">
            <Rectangle height="62" width="310" x="0" y="0">
                <Fill color="#dd000000" />
                <Stroke color="#ffffffff" thickness="3" />
            </Rectangle>
        </PartDraw>
        <PartText height="42" width="300" x="75" y="32">
            <Text>
                <Font color="#ffffffff" family="markin_lt_ultrabold" size="27">
                    <Template><![CDATA[%s %s %s]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH_S]" />
                        <Parameter expression="[DAY_Z]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <DigitalClock height="150" width="410" x="20" y="105">
            <TimeText format="hh:mm" hourFormat="24" height="150" width="410" x="0" y="0">
                <Font color="#0d0d0d" family="markin_lt_ultrabold" size="132" weight="NORMAL" />
            </TimeText>
            <TimeText format="hh:mm" hourFormat="24" height="150" width="410" x="0" y="0">
                <Font color="#ffffffff" family="markin_lt_ultrabold" size="126" weight="NORMAL" />
            </TimeText>
            <TimeText alpha="0" format="hh:mm" hourFormat="24" height="150" width="410" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font color="#0d0d0d" family="markin_lt_ultrabold" size="132" weight="THIN" />
            </TimeText>
            <TimeText alpha="0" format="hh:mm" hourFormat="24" height="150" width="410" x="0" y="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font color="#ffffffff" family="markin_lt_ultrabold" size="126" weight="THIN" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot
            displayName="weather_complication"
            height="70"
            slotId="0"
            supportedTypes="SHORT_TEXT LONG_TEXT EMPTY"
            width="180"
            x="30"
            y="305">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox height="50" width="140" x="0" y="0" />
            <Complication type="SHORT_TEXT">
                <PartText height="50" width="140" x="0" y="0">
                    <Text ellipsis="TRUE">
                        <Font color="#ffffffff" family="markin_lt_ultrabold" size="24">
                            <Template><![CDATA[%s %s]]>
                                <Parameter expression="[COMPLICATION.TITLE]" />
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText height="70" width="180" x="0" y="0">
                    <Text ellipsis="TRUE">
                        <Font color="#ffffffff" family="markin_lt_ultrabold" size="20">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            displayName="steps_complication"
            height="70"
            slotId="1"
            supportedTypes="SHORT_TEXT LONG_TEXT RANGED_VALUE GOAL_PROGRESS EMPTY"
            width="110"
            x="0"
            y="305">
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox height="70" width="110" x="0" y="0" />
            <Complication type="SHORT_TEXT">
                <PartText height="70" width="110" x="0" y="0">
                    <Text ellipsis="TRUE">
                        <Font color="#ffffffff" family="markin_lt_ultrabold" size="22">
                            <Template><![CDATA[STEPS %s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText height="70" width="110" x="0" y="0">
                    <Text ellipsis="TRUE">
                        <Font color="#ffffffff" family="markin_lt_ultrabold" size="18">
                            <Template><![CDATA[%s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            displayName="battery_complication"
            height="50"
            slotId="2"
            supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            width="160"
            x="340"
            y="382">
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox height="50" width="110" x="0" y="0" />
            <Complication type="SHORT_TEXT">
                <PartText height="50" width="110" x="0" y="0">
                    <Text ellipsis="TRUE">
                        <Font color="#ffffffff" family="markin_lt_ultrabold" size="18">
                            <Template><![CDATA[BATT %s]]>
                                <Parameter expression="[COMPLICATION.TEXT]" />
                            </Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
